# Plataforma de Gestão de TI — .gitignore

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/

# --- Virtual environments ---
.venv/
venv/
ENV/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Environment ---
.env
.env.*
!.env.example
*.env.local

# --- Certificados TLS locais (chave privada!) ---
certs/

# --- Node / Angular ---
node_modules/
frontend/dist/
frontend/.angular/

# --- Docker ---
*.log

# --- OS ---
.DS_Store
Thumbs.db

# --- Backups ---
backups/

# --- Pytest ---
.pytest_cache/
.coverage
htmlcov/

# --- MyPy ---
.mypy_cache/

# --- Ruff ---
.ruff_cache/

# --- Bancos de dados locais / testes ---
*.db
*.sqlite
*.sqlite3

# --- Uploads / Anexos ---
uploads/
**/uploads/

# --- Inventários GLPI reais (contêm chave do Windows, IPs/MACs e usuários) ---
docs/INVENTARIO_MODELO.xml

# --- Dumps e backups de banco (podem conter dados reais) ---
*.sql.gz
*.dump
pre-restore-*

# --- Chaves e certificados fora de certs/ ---
*.pem

# Cópia dos volumes de anexos/logo gerada por scripts/backup.sh (pode conter anexos reais)
arquivos_*.tar.gz
