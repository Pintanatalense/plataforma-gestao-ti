# =============================================================================
# Nginx — modo HTTPS (certificado autoassinado ou próprio). Ativado por docker-compose.https.yml.
# Arquivo-modelo: o Nginx substitui ${HTTPS_PORT} na subida (envsubst).
# =============================================================================

# Limite de tentativas de login por IP (a conta já bloqueia após 5 senhas erradas; isto freia varredura
# de várias contas a partir de um mesmo endereço). Resposta 429 ao exceder.
limit_req_zone $binary_remote_addr zone=login_limit:10m rate=30r/m;

upstream backend {
    server backend:8000;
}

# HTTP só redireciona para HTTPS
server {
    listen 80;
    server_name _;
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1h;

    include /etc/nginx/snippets/app-locations.conf;
}
