# =============================================================================
# Variáveis de ambiente — Plataforma de Gestão de TI
#
# Copie este arquivo para .env e configure os valores:
#   cp .env.example .env
#
# NUNCA commit o arquivo .env no repositório!
# =============================================================================

# --- Banco de Dados ---
POSTGRES_DB=gestao_ti
POSTGRES_USER=postgres
# OBRIGATÓRIO: defina uma senha forte (o banco não é exposto no host por padrão)
POSTGRES_PASSWORD=
DB_PORT=5432

# --- Backend ---
# OBRIGATÓRIO: openssl rand -hex 32  (o sistema recusa subir com valor de exemplo ou < 32 caracteres)
SECRET_KEY=
# OBRIGATÓRIO: chave que cifra segredos de canais (senha SMTP, tokens). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia FORA do servidor e do backup do banco: sem ela os segredos gravados não podem ser lidos.
APP_ENCRYPTION_KEY=
# Fuso das agendas do worker (backup diário às 02:00, limpeza às 03:30)
APP_TIMEZONE=America/Fortaleza
DEBUG=false
API_PORT=8000

# --- Nginx ---
HTTP_PORT=80
# Porta HTTPS (só usada com `scripts/install.sh --https`, que também define COMPOSE_FILE)
HTTPS_PORT=443

# --- Anexos ---
# Tamanho máximo de anexo em MB
ATTACHMENT_MAX_SIZE_MB=100
