# =============================================================================
# Variáveis de ambiente — Plataforma de Gestão de TI
#
# Copie este arquivo para .env e configure os valores:
#   cp .env.example .env
#
# NUNCA commit o arquivo .env no repositório!
# =============================================================================

# --- Banco de Dados ---
POSTGRES_DB=gestao_ti
POSTGRES_USER=postgres
# OBRIGATÓRIO: defina uma senha forte (o banco não é exposto no host por padrão).
# É a senha do SUPERUSUÁRIO: só o serviço db-init a recebe (ADR-022).
POSTGRES_PASSWORD=
DB_PORT=5432

# --- Papéis de banco (ADR-022) ---
# O db-init cria/atualiza estes papéis a cada "docker compose up" (trocar a senha aqui troca no banco):
#   dono      -> dono das tabelas; só ele roda migrations
#   aplicação -> backend e worker: lê e grava dados, sem alterar a estrutura
#   Evolution -> só o schema evolution_api (WhatsApp)
# OBRIGATÓRIO: 16+ caracteres, só letras, números e . _ ~ -  (gere com: openssl rand -hex 16)
# Voltar ao superusuário (rollback): ponha POSTGRES_USER em DB_*_USER e POSTGRES_PASSWORD em DB_*_PASSWORD.
DB_OWNER_USER=gestao_owner
DB_OWNER_PASSWORD=
DB_APP_USER=gestao_app
DB_APP_PASSWORD=
DB_EVOLUTION_USER=gestao_evolution
DB_EVOLUTION_PASSWORD=

# --- Backend ---
# OBRIGATÓRIO: openssl rand -hex 32  (o sistema recusa subir com valor de exemplo ou < 32 caracteres)
SECRET_KEY=
# OBRIGATÓRIO: chave que cifra segredos de canais (senha SMTP, tokens). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia FORA do servidor e do backup do banco: sem ela os segredos gravados não podem ser lidos.
APP_ENCRYPTION_KEY=
# Fuso das agendas do worker (backup diário às 02:00, limpeza às 03:30)
APP_TIMEZONE=America/Fortaleza
DEBUG=false
# Nível dos logs: DEBUG, INFO, WARNING ou ERROR
LOG_LEVEL=INFO
# Carga de QA (/system/demo/seed-test) cria o admin admin@teste.local com senha conhecida. Só em homologação.
ENABLE_QA_SEED=false
# Swagger/ReDoc/openapi.json em /api/v1/docs. Desligado por padrão; use true só em desenvolvimento/homologação.
ENABLE_API_DOCS=false
# Retenção da auditoria (dias). Segurança: mínimo 1825 (5 anos). Os vencidos são arquivados antes de apagar.
AUDIT_RETENTION_SECURITY_DAYS=1825
AUDIT_RETENTION_OPERATIONAL_DAYS=730
API_PORT=8000

# --- WhatsApp pela Evolution API (opcional, ADR-019) ---
# Chave que o backend usa para falar com a Evolution (e que a própria Evolution exige). Gere com: openssl rand -hex 24
# Só é preciso para usar o WhatsApp. Suba o serviço com:  docker compose --profile whatsapp up -d
EVOLUTION_API_KEY=

# --- Nginx ---
HTTP_PORT=80
# Porta HTTPS (só usada com `scripts/install.sh --https`, que também define COMPOSE_FILE)
HTTPS_PORT=443

# --- Anexos ---
# Tamanho máximo de anexo em MB (o Nginx também limita o corpo da requisição a 100 MB:
# para aceitar mais, ajuste client_max_body_size em nginx/app-locations.conf)
ATTACHMENT_MAX_SIZE_MB=100
